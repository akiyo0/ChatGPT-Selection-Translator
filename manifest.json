{
  "manifest_version": 3,
  "name": "ChatGPT Selection Translator",
  "version": "1.1.0",
  "description": "Translate selected text on any webpage or PDF via right-click, shortcut or toolbar button, using OpenAI, Gemini, or compatible APIs.",
  "permissions": ["contextMenus", "storage", "scripting", "activeTab"],
  "host_permissions": ["https://api.openai.com/*", "https://generativelanguage.googleapis.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Translate selection (default target language)"
  },
  "options_page": "options.html",
  "commands": {
    "translate-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Quickly translate the current selection using the default target language"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
